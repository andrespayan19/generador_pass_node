@startuml
title Caso de Uso - Generador de Contraseñas Seguras

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Usuario" as Usuario
actor "Administrador\n/ Funcionario" as Admin

rectangle "Sistema Generador de Contraseñas Seguras" {

    usecase "Generar contraseña" as UC1
    usecase "Configurar longitud\nde contraseña" as UC2
    usecase "Incluir símbolos" as UC3
    usecase "Incluir números" as UC4
    usecase "Visualizar contraseña\ngenerada" as UC5
    usecase "Guardar contraseña\nen archivo" as UC6
    usecase "Validar unicidad\nde contraseñas" as UC7
    usecase "Ejecutar pruebas\nde seguridad" as UC8
    usecase "Mostrar resultado\nen consola con chalk" as UC9

}

Usuario --> UC1
Usuario --> UC2
Usuario --> UC3
Usuario --> UC4
Usuario --> UC5
Usuario --> UC6

Admin --> UC7
Admin --> UC8

UC1 .> UC2 : <<include>>
UC1 .> UC3 : <<include>>
UC1 .> UC4 : <<include>>
UC1 .> UC5 : <<include>>
UC5 .> UC9 : <<include>>

UC6 .> UC1 : <<extend>>

UC8 .> UC7 : <<include>>

@enduml